  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.94509804, g: 0.92156863, b: 0.8666667, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: b8c8973f706b87f41a7cbf8faa570775, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "1  \uC190\uD328\uC758 \uC870\uAC01\uC744 \uB04C\uC5B4 \uB3C4\uC548\uC758
    \uBE48 \uACF3\uC5D0 \uB193\uC73C\uC138\uC694.\n    \uB4E4\uACE0 \uC788\uB294
    \uB3D9\uC548 R \uB610\uB294 \uC6B0\uD074\uB9AD\uC73C\uB85C \uB3CC\uB9B4 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n2  \uB3C4\uC548\uC744 \uBE48\uD2C8\uC5C6\uC774 \uCC44\uC6B0\uBA74
    \uC2DC\uC804\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n    \uB300\uC0C1\uC774 \uD544\uC694\uD55C
    \uC8FC\uBB38\uC740 \uC2DC\uC804 \uBC84\uD2BC\uC744 \uB204\uB978 \uB4A4 \uC801\uC744
    \uD074\uB9AD\uD558\uAC70\uB098,\n    \uC2DC\uC804 \uBC84\uD2BC\uC744 \uC801\uC5D0\uAC8C
    \uB04C\uC5B4 \uB193\uC73C\uC138\uC694.\n3  \uC774\uBC88 \uD134\uC5D0 \uB193\uC740
    \uC870\uAC01\uC740 \uC62E\uAE30\uAC70\uB098 \uC6B0\uD074\uB9AD\uC73C\uB85C \uC190\uD328\uC5D0
    \uB418\uB3CC\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n4  \uD134\uC744 \uB05D\uB0B4\uBA74
    \uC190\uD328\uB294 \uBC84\uB9B0 \uB354\uBBF8\uB85C \uAC00\uACE0 \uC801\uC774
    \uD589\uB3D9\uD569\uB2C8\uB2E4.\n    \uB3C4\uC548\uC5D0 \uB193\uC778 \uC870\uAC01\uC740
    \uACE0\uC815\uB418\uC5B4 \uB2E4\uC74C \uD134\uC5D0\uB3C4 \uB0A8\uC2B5\uB2C8\uB2E4.\n   
    \uBC29\uC5B4\uB3C4\uB294 \uC801\uC774 \uD589\uB3D9\uD55C \uB4A4 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\n5 
    \uACE0\uC815\uB41C \uC870\uAC01\uC740 \uC62E\uAE38 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
    \u300C\xB7\xB7\xB7\u300D \u2192 \u300C\uB3C4\uC548 \uBE44\uC6B0\uAE30\u300D\uB85C
    \uCE58\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
